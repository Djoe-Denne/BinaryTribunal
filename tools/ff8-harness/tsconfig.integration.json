    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "@opencode/client": ["./node_modules/@opencode/client/dist/promise/index.d.ts"],
      "@opencode/client/service": ["./node_modules/@opencode/client/dist/promise/service.d.ts"]
    }
  },
  "include": [
