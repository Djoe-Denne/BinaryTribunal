+/** Internal source-hex/native-uint32 bridge. Never rewrites either identity or
+ * grants authority; all non-address fields retain exact canonical equality. */
+export function sourceNativeFunctionIdentityMatchesV1(source: unknown, native: unknown): boolean {
+  if (!source || !native || typeof source !== "object" || typeof native !== "object"
+    || Array.isArray(source) || Array.isArray(native)) return false;
+  try {
+    const s = source as Record<string, unknown>, n = native as Record<string, unknown>;
+    if (s.sha256 !== n.sha256 || s.version !== n.version || typeof n.sha256 !== "string"
+      || !/^[a-f0-9]{64}$/.test(n.sha256)) return false;
+    if (typeof n.ea !== "number" || !Number.isSafeInteger(n.ea) || Object.is(n.ea, -0)
+      || n.ea <= 0 || n.ea > 0xffffffff) return false;
+    const ea = BigInt(validateIdentity(s).ea);
+    if (ea <= 0n || ea > 0xffffffffn) return false;
+    return canonical({ ...s, ea: Number(ea) }) === canonical(n);
+  } catch { return false; }
+}
